managed implementation in class zbp_i_booking_t35 unique;
strict ( 2 );

with draft;

define behavior for ZI_BOOKING_T35 alias Booking
//persistent table zbooking_T35
draft table zbooking_T35_d
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
with unmanaged save
// Numbering = cấp key KHI NÀO & thế nào:
//   I. Interaction phase:
//      1. Managed(UUID): field ( numbering : managed ) Key;  (framework sinh UUID, không handler)
//      2. Early internal: early numbering -> earlynumbering_create (semantic key tự tăng) << case ta dùng
//      3. Early external: early numbering (không sinh, user tự nhập ID)
//   II. Save phase:
//      4. Late: late numbering -> adjust_numbers (saver) (key phụ thuộc hệ ngoài / sequence lúc commit)
early numbering
{
  create;
  update;
  delete;

  // 1. Nút Process: Tương tác với các dòng được chọn (Instance Action)
  action ProcessData result [1] $self;

  // 2. Nút GetFilter: Không cần chọn dòng (Static Action) và Gọi ra Dialog (Parameter)
  static action GetFilter parameter ZA_FILTER_PARAM_T35 result [1] $self;

  action acceptBooking result [1] $self;
  action cancelBooking result [1] $self;

  action applyDiscount parameter ZA_BOOKING_DISC_T35 result [1] $self;

  field ( readonly )
  BookingId,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  field ( mandatory )
  CustomerId,
  BookingDate;

  association _BookingItem { create; with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare { }

    mapping for zbooking_T35
    {
      BookingId          = booking_id;
      CustomerId         = customer_id;
      BookingDate        = booking_date;
      Description        = description;
      TotalPrice         = total_price;
      CurrencyCode       = currency_code;
      OverallStatus      = overall_status;
      ConfirmFlag        = confirm_flag;
      Priority           = priority;
      CustomerRating     = customer_rating;
      CompletionPct      = completion_pct;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

//===================== CHILD: BookingItem =====================
define behavior for ZI_ITEM_T35 alias BookingItem         // alias <alias_name>
//persistent table zbkitem_T35\
with unmanaged save
draft table zbkitem_T35_d
lock dependent by _bookingHeader              // khoá con ĐI THEO khoá cha
authorization dependent by _bookingHeader     // quyền con THỪA HƯỞNG từ cha -> KHÔNG cần handler riêng
etag master LocalLastChangedAt                // item có timestamp riêng -> etag master hợp lệ
{
  update;
  delete;

  field ( readonly ) BookingId;
  field ( readonly : update ) ItemId;
  field ( mandatory ) ProductId, Quantity;

  association _BookingHeader { with draft; }
  determination calculateTotalPrice on modify { field quantity, itemprice; }
  mapping for zbkitem_T35
    {
      BookingId          = booking_id;
      ItemId             = item_id;
      ProductId          = product_id;
      Quantity           = quantity;
      QuantityUnit       = quantity_unit;
      ItemPrice          = item_price;
      CurrencyCode       = currency_code;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }

}