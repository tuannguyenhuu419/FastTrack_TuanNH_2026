projection;
strict ( 2 );
use draft;

define behavior for ZC_BOOKING_T35 alias Booking
{
  use create;
  use update;
  use delete;

  use action acceptBooking;
  use action cancelBooking;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _BookingItem { create; with draft; }
}

define behavior for ZC_ITEM_T35 alias BookingItem
{
  use update;
  use delete;

  use association _BookingHeader { with draft; }
}